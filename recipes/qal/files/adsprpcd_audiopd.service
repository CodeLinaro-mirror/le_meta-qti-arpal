[Unit]
Description=Audio adsprpc Service
SourcePath=/usr/bin/adsprpcd

[Service]
User=system
Group=system
Restart=on-failure
ExecStart=/usr/bin/adsprpcd audiopd

[Install]
WantedBy=multi-user.target
